{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "publisher",
  "projectType": "library",
  "sourceRoot": "projects/publisher",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project ./projects/publisher/tsconfig.json"
      },
      "outputs": ["{projectRoot}/bin"]
    },
    "publish": {
      "dependsOn": [
        {
          "dependencies": false,
          "params": "ignore",
          "target": "build"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "npm publish ./projects/publisher --access=public --ignore-scripts"
      }
    }
  }
}
