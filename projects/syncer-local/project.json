{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "syncer",
  "projectType": "library",
  "sourceRoot": "projects/syncer",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project ./projects/syncer/tsconfig.json"
      },
      "outputs": ["{projectRoot}/projects/syncer"]
    },
    "publish": {
      "dependsOn": [
        {
          "dependencies": false,
          "params": "ignore",
          "target": "build"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "npm publish ./projects/syncer --access=public --ignore-scripts"
      }
    }
  }
}
