{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "syncer",
  "projectType": "library",
  "sourceRoot": "projects/syncer-local",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/syncer",
        "main": "projects/syncer-local/src/index.ts",
        "tsConfig": "projects/syncer-local/tsconfig.lib.json",
        "assets": ["projects/syncer-local/*.md"],
        "generatePackageJson": true
      },

      "outputs": ["{workspaceRoot}/dist/syncer"]
    },
    "publish": {
      "dependsOn": [
        {
          "dependencies": false,
          "params": "ignore",
          "target": "build"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ts-node projects/publisher/src/index.ts --path ./dist/syncer"
      }
    }
  }
}
