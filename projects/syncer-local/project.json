{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "syncer",
  "projectType": "library",
  "sourceRoot": "projects/syncer-local",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project ./projects/syncer-local/tsconfig.json"
      },
      "outputs": ["{projectRoot}/projects/syncer-local"]
    },
    "publish": {
      "dependsOn": [
        {
          "dependencies": false,
          "params": "ignore",
          "target": "build"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ts-node projects/publisher/src/index.ts --path=projects/syncer-local --binPath=projects/syncer-local/bin"
      }
    }
  }
}
