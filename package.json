{
  "name": "actions-plugins",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "build": "nx build toolkit",
    "release": "npx syncer"
  },
  "devDependencies": {
    "@taiga-ui/syncer": "^0.554.0",
    "nx": "^21.0.0",
    "release-it": "^18.0.0"
  },
  "syncer": {
    "includePaths": [
      "./projects",
      "./package-lock.json"
    ],
    "matchPackageNames": [
      "release-it"
    ]
  }
}
