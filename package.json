{
  "name": "actions-plugins",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nx build toolkit",
    "release": "npx nx run-many --target publish --all"
  },
  "devDependencies": {
    "nx": "^21.0.0",
    "release-it": "^18.0.0"
  },
  "syncer": {
    "includePaths": [
      "./projects",
      "./package-lock.json"
    ],
    "matchPackageNames": [
      "release-it"
    ]
  }
}