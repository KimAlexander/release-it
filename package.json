{
  "name": "actions-plugins",
  "version": "0.8.0",
  "private": true,
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "build": "nx build toolkit",
    "release": "npx nx publish syncer"
  },
  "devDependencies": {
    "@taiga-ui/syncer": "^0.554.0",
    "@types/node": "^26.1.2",
    "nx": "23.0.1",
    "release-it": "^21.0.0",
    "typescript": "5.8.3"
  },
  "syncer": {
    "includePaths": [
      "./projects",
      "./package-lock.json"
    ],
    "matchPackageNames": [
      "release-it"
    ]
  },
  "release-it": {
    "extends": "./projects/release-it-config/.release-it.js"
  }
}
