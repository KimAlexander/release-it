{
    "compileOnSave": false,
    "compilerOptions": {
        "declaration": false,
        "moduleResolution": "bundler",
        "experimentalDecorators": true,
        "target": "es2015",
        "module": "es2020",
        "lib": ["es2017", "es2018.asynciterable", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "paths": {
            "@config-scripts-web/config": ["./projects/config/index"],
            "@config-scripts-web/config/*": ["./projects/config/*"],
            "@config-scripts-web/scripts": ["./projects/scripts/src/index.ts"]
        }
    },
    "exclude": ["projects/**/*.spec.ts"]
}